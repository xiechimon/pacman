{
  "flow": "chief-dispatch",
  "note": "Chief 派发决策评测的输入集。roster 是每轮 seed 进隔离库的团队编制；cases 是用户请求 + 期望决策。expect.kind: dispatch = 应派工（agent 给期望归属）；hold = 不应派工（run_builds 不得被调用）。",
  "roster": [
    {
      "key": "doc",
      "displayName": "阿岚",
      "modelId": "qwen3.8-max",
      "description": "负责 README、用户手册、教程、变更日志、发布说明等面向读者的文档产出。交付物是文档内容本身，不修改业务代码。"
    },
    {
      "key": "code",
      "displayName": "老周",
      "modelId": "glm-5.3",
      "description": "负责后端功能实现、缺陷修复、重构与性能优化。改动范围是 apps/server、apps/daemon 与 packages；不处理界面样式。"
    },
    {
      "key": "frontend",
      "displayName": "小柯",
      "modelId": "kimi-k3",
      "description": "负责 Web 界面的布局、样式、交互与前端组件，改动范围是 apps/web。不处理后端接口与数据结构。"
    },
    {
      "key": "ops",
      "displayName": "铁手",
      "modelId": "glm-5.3",
      "description": "负责 CI 流水线、构建与打包脚本、依赖升级、部署配置与本地开发环境。不实现业务功能。"
    }
  ],
  "cases": [
    { "id": "d01", "tags": ["dispatch", "doc", "plain"], "prompt": "README 的安装步骤不全，帮我补成一份新手能照着走的教程。", "expect": { "kind": "dispatch", "agent": "doc" } },
    { "id": "d02", "tags": ["dispatch", "doc", "plain"], "prompt": "给这次发版写一份更新日志。", "expect": { "kind": "dispatch", "agent": "doc" } },
    { "id": "d03", "tags": ["dispatch", "doc", "oblique"], "prompt": "这个项目的使用说明写得跟天书一样，重写一版。", "expect": { "kind": "dispatch", "agent": "doc" } },
    { "id": "d04", "tags": ["dispatch", "doc", "plain"], "prompt": "docs 里那堆零散的说明太乱了，整理成一份完整的用户手册。", "expect": { "kind": "dispatch", "agent": "doc" } },
    { "id": "d05", "tags": ["dispatch", "doc", "oblique"], "prompt": "新来的同事说不知道从哪上手，弄一份上手指南出来。", "expect": { "kind": "dispatch", "agent": "doc" } },
    { "id": "d06", "tags": ["dispatch", "doc", "plain"], "prompt": "把这次改动的 API 变化整理成一份迁移说明，发给用我们接口的人。", "expect": { "kind": "dispatch", "agent": "doc" } },

    { "id": "c01", "tags": ["dispatch", "code", "plain"], "prompt": "登录接口在密码错误的时候返回 500，应该返回 401，修一下。", "expect": { "kind": "dispatch", "agent": "code" } },
    { "id": "c02", "tags": ["dispatch", "code", "oblique"], "prompt": "任务列表查询越来越慢，看看能不能优化。", "expect": { "kind": "dispatch", "agent": "code" } },
    { "id": "c03", "tags": ["dispatch", "code", "plain"], "prompt": "server 里鉴权逻辑重复了三遍，抽成一个中间件。", "expect": { "kind": "dispatch", "agent": "code" } },
    { "id": "c04", "tags": ["dispatch", "code", "plain"], "prompt": "导出功能偶尔会漏掉最后几行，查一下什么原因。", "expect": { "kind": "dispatch", "agent": "code" } },
    { "id": "c05", "tags": ["dispatch", "code", "plain"], "prompt": "批量删除任务的时候只删掉了第一条，剩下的没删。", "expect": { "kind": "dispatch", "agent": "code" } },
    { "id": "c06", "tags": ["dispatch", "code", "oblique"], "prompt": "搜索结果排序不对，更新时间的排在创建时间前面了。", "expect": { "kind": "dispatch", "agent": "code" } },

    { "id": "f01", "tags": ["dispatch", "frontend", "plain"], "prompt": "看板列宽太窄，卡片标题被截断了，调一下。", "expect": { "kind": "dispatch", "agent": "frontend" } },
    { "id": "f02", "tags": ["dispatch", "frontend", "oblique"], "prompt": "切换主题的时候侧栏会闪一下白屏。", "expect": { "kind": "dispatch", "agent": "frontend" } },
    { "id": "f03", "tags": ["dispatch", "frontend", "plain"], "prompt": "新建任务的弹窗在手机上看不全，按钮点不到。", "expect": { "kind": "dispatch", "agent": "frontend" } },
    { "id": "f04", "tags": ["dispatch", "frontend", "oblique"], "prompt": "拖拽卡的阴影太浅，看不出来它浮起来了。", "expect": { "kind": "dispatch", "agent": "frontend" } },
    { "id": "f05", "tags": ["dispatch", "frontend", "plain"], "prompt": "侧栏的项目组列表滚动到一半会卡住。", "expect": { "kind": "dispatch", "agent": "frontend" } },
    { "id": "f06", "tags": ["dispatch", "frontend", "plain"], "prompt": "日期选择器的下拉层被下面的卡片盖住了。", "expect": { "kind": "dispatch", "agent": "frontend" } },

    { "id": "o01", "tags": ["dispatch", "ops", "plain"], "prompt": "CI 跑测试老是因为超时挂掉，把超时调大点。", "expect": { "kind": "dispatch", "agent": "ops" } },
    { "id": "o02", "tags": ["dispatch", "ops", "plain"], "prompt": "给仓库加个 pre-commit 钩子，提交前自动跑 lint。", "expect": { "kind": "dispatch", "agent": "ops" } },
    { "id": "o03", "tags": ["dispatch", "ops", "plain"], "prompt": "把项目的 Node 版本升到 22，构建脚本一起改。", "expect": { "kind": "dispatch", "agent": "ops" } },
    { "id": "o04", "tags": ["dispatch", "ops", "oblique"], "prompt": "本地起 dev 环境总是端口冲突，能不能让它自动选端口。", "expect": { "kind": "dispatch", "agent": "ops" } },
    { "id": "o05", "tags": ["dispatch", "ops", "oblique"], "prompt": "发布流程每次都要手动改版本号，做成自动的。", "expect": { "kind": "dispatch", "agent": "ops" } },
    { "id": "o06", "tags": ["dispatch", "ops", "plain"], "prompt": "Docker 镜像构建太慢了，加个层缓存。", "expect": { "kind": "dispatch", "agent": "ops" } },

    { "id": "n01", "tags": ["hold", "query"], "prompt": "现在有几个任务在跑？", "expect": { "kind": "hold", "why": "读状态回答，不该派活" } },
    { "id": "n02", "tags": ["hold", "ambiguous"], "prompt": "帮我优化一下。", "expect": { "kind": "hold", "why": "信息不足，该先澄清" } },
    { "id": "n03", "tags": ["hold", "query"], "prompt": "那个 bug 修了吗？", "expect": { "kind": "hold", "why": "查状态回答" } },
    { "id": "n04", "tags": ["hold", "chitchat"], "prompt": "你好", "expect": { "kind": "hold", "why": "寒暄，无任务" } },
    { "id": "n05", "tags": ["hold", "defer"], "prompt": "先记一下：下周要把导出改成异步的，这周先别动。", "expect": { "kind": "hold", "why": "用户明确说先别做——至多建 todo，不得派工" } },
    { "id": "n06", "tags": ["hold", "query"], "prompt": "刚才那个任务停了，什么情况？", "expect": { "kind": "hold", "why": "查状态回答" } },
    { "id": "n07", "tags": ["hold", "query"], "prompt": "这个项目用的什么数据库？", "expect": { "kind": "hold", "why": "读仓库回答，不是派活" } },
    { "id": "n08", "tags": ["hold", "advice"], "prompt": "你觉得这几个任务应该先做哪个？", "expect": { "kind": "hold", "why": "要建议，不是派工" } },
    { "id": "n09", "tags": ["hold", "query"], "prompt": "我刚才说的那个任务，spec 你再念一遍。", "expect": { "kind": "hold", "why": "复述，不派工" } },
    { "id": "n10", "tags": ["hold", "query"], "prompt": "团队里有几个 Agent？", "expect": { "kind": "hold", "why": "读资源清单回答" } },
    { "id": "n11", "tags": ["hold", "state-change"], "prompt": "把任务 #3 关掉。", "expect": { "kind": "hold", "why": "该走 close_todos，不是 run_builds" } },
    { "id": "n12", "tags": ["hold", "query"], "prompt": "这个任务为什么要拆成两步？", "expect": { "kind": "hold", "why": "解释，不派工" } }
  ]
}