{
  "name": "@pacman/server",
  "version": "0.13.3",
  "description": "Standalone headless Pacman server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "pacman-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": "xiechimon",
  "license": "Apache-2.0",
  "homepage": "https://github.com/xiechimon/pacman",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pacman/core": "workspace:*",
    "@pacman/messaging-gateway": "workspace:*",
    "@pacman/server-core": "workspace:*",
    "@pacman/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
