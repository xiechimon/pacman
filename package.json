{
  "name": "pacman",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @pacman/web dev",
    "dev:server": "pnpm --filter @pacman/server dev",
    "dev:daemon": "pnpm --filter @pacman/cli dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "parity": "node parity/run.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "husky": "^9.1.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
