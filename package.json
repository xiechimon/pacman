{
  "name": "pacman",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -n web,server,daemon -c blue,magenta,green \"pnpm dev:web\" \"pnpm dev:server\" \"pnpm dev:daemon\"",
    "dev:web": "PACMAN_DEV_WEB_PORT=5300 PACMAN_DEV_SERVER_PORT=8899 pnpm --filter @pacman/web dev",
    "dev:server": "PORT=8899 pnpm --filter @xiechimon/pacman dev",
    "dev:daemon": "PACMAN_SERVER=http://127.0.0.1:8899 pnpm --filter @xiechimon/pacman-cli dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @pacman/web build && pnpm --filter @xiechimon/pacman start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lucide-static": "^1.48.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
