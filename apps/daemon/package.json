  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@pacman/shared": "workspace:*",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "undici": "8.10.2",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
