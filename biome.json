{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/web/src/**",
      "apps/web/index.html",
      "apps/web/vite.config.ts",
      "apps/web/tailwind.config.js",
      "apps/web/postcss.config.js",
      "apps/web/tsconfig.json",
      "apps/web/package.json",
      "packages/shared/src/**",
      "packages/shared/test/**/*.ts",
      "packages/shared/package.json",
      "packages/shared/tsconfig.json",
      "apps/server/src/**",
      "apps/server/test/**/*.ts",
      "apps/server/package.json",
      "apps/server/tsconfig.json",
      "apps/server/drizzle.config.ts",
      "vitest.config.ts",
      "parity/*.mjs",
      "scripts/**",
      "package.json",
      "pnpm-workspace.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
