{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/web/src/**",
      "apps/web/index.html",
      "apps/web/vite.config.ts",
      "apps/web/tailwind.config.js",
      "apps/web/postcss.config.js",
      "apps/web/tsconfig.json",
      "apps/web/package.json",
      "packages/shared/src/**",
      "packages/shared/test/**/*.ts",
      "packages/shared/package.json",
      "packages/shared/tsconfig.json",
      "apps/server/src/**",
      "apps/server/test/**/*.ts",
      "apps/server/package.json",
      "apps/server/tsconfig.json",
      "apps/server/drizzle.config.ts",
      "apps/daemon/src/**",
      "apps/daemon/test/**/*.ts",
      "apps/daemon/build.mjs",
      "apps/daemon/package.json",
      "apps/daemon/tsconfig.json",
      "integration/test/**/*.ts",
      "integration/*.ts",
      "integration/package.json",
      "vitest.config.ts",
      "parity/*.mjs",
      "scripts/**",
      "package.json",
      "pnpm-workspace.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@earendil-works/*", "@earendil-works/*/*"],
                "message": "缝纪律（01 §5/§7.3）：pi 系包只许经 AgentBackend 缝消费——实现落 apps/daemon/src/backend/，其余模块 import 缝接口（@pacman/shared agent-backend）。"
              }
            ],
            "paths": {
              "cron-parser": "缝纪律（01 §3/§7.3）：cron-parser 只许 Scheduler 缝实现消费（02 §9.2 词表的自建调度循环内）。",
              "@modelcontextprotocol/sdk": "缝纪律（00/D4、01 §7.3）：MCP sdk 只许自建薄桥模块消费（server /api/mcp 面与 daemon per-turn client 桥）。",
              "simple-git": "缝纪律（01 §3/S10、§7.3）：GitOps 缝 = spawn 系统 git 自建薄 wrapper，simple-git 明文不引入。",
              "isomorphic-git": "缝纪律（01 §3/S10、§7.3）：GitOps 缝 = spawn 系统 git 自建薄 wrapper，isomorphic-git 明文不引入（无 http-backend/worktree 面）。"
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/daemon/src/backend/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/services/schedules.ts",
        "apps/server/src/services/scheduler.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
