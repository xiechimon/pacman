<mxfile host="Electron">
  <diagram name="editability-gate" id="0">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="960" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" value="docs/verify diagram gate: two checks, one script (#1107)" vertex="1">
          <mxGeometry height="30" width="760" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="input1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="every docs/verify/**/*.drawio.svg in the tree" vertex="1">
          <mxGeometry height="80" width="240" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="gate1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="scripts/check-diagram-text-fit.py" vertex="1">
          <mxGeometry height="80" width="240" x="340" y="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="input1" target="gate1" style="html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="check 2 judges editability, not quality: this corpus has no quality variance, so quality cannot be machine-judged" vertex="1">
          <mxGeometry height="140" width="260" x="40" y="220" as="geometry" />
        </mxCell>
        <mxCell id="check1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="check 1: every label fits its shape (calibrated 4/4, #1087)" vertex="1">
          <mxGeometry height="90" width="260" x="340" y="220" as="geometry" />
        </mxCell>
        <mxCell id="check2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="check 2 (new): same-name .drawio source ships with the export (#1107)" vertex="1">
          <mxGeometry height="90" width="260" x="340" y="340" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="gate1" target="check1" style="html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="gate1" target="check2" style="html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="verdict1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="exit 0 only when both checks pass; CI job diagram-text-fit stays advisory" vertex="1">
          <mxGeometry height="100" width="220" x="660" y="280" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="check1" target="verdict1" style="html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="check2" target="verdict1" style="html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
