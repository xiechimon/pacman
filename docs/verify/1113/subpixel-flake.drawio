<mxfile host="app.diagrams.net" agent="pacman #1113">
  <diagram id="subpixel-flake-1113" name="#1113 亚像素 flake 根因与修法">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="修前：toBe(262) 钉变换后的 rect 宽度 → 入场动画期采样必飘" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="总管窗进场腿 zoom-in-95：scale 0.95→1，时长 200ms（WINDOW_MOTION_CLS）；主题切换器菜单随整窗一起被变换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="40" y="88" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="getBoundingClientRect().width 变换敏感：动画中读到 262×scale(t)。探针实测首帧 248.9（=262×0.95），中后段 261.784——与 CI 收到的 261.78 / 260.34 同值域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="40" y="192" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="本地快机 goto→visible→evaluate 恒落在动画结束后 → 常绿；CI 高负载掉帧，同一管线落进 200ms 动画窗 → 假红（毒死 main 两条 run，咬过 #1105）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="40" y="308" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="toBe(262) 精确等值撞上飘移采样 = 亚像素假红；而它想钉的事实（布局宽度未被 #1094 改动）从未变过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="40" y="424" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450" edge="1" parent="1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450" edge="1" parent="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="修后：offsetWidth 钉布局整数 → 零飘移，精确 pin 保留" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="480" y="24" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="测量换 el.offsetWidth：布局整数，定义上免疫变换——动画任意帧恒 262（探针 12/12 次加载逐帧采样 0 飘移），toBe(262) 保持精确" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="480" y="88" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="为何不用容差：最坏采样落动画首帧，ε 需 ≥13.1px 才不飘——该容差会吞掉同量级真回归；offsetWidth 零飘移，无须用精度换稳定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="480" y="192" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="真回归照抓（双向实测红）：w-[262px] 改 w-[300px] → Expected 262, Received 300；摘掉 #1094 封顶 → test 1 菜单底 824 &gt; 窗底 724 红" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="480" y="308" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="同文件其余数值断言审计：clientHeight=68、scrollHeight 比较是布局量，boundingBox 包含关系是同变换空间内的关系式——均免疫变换，不动（不扩成重构）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="480" y="424" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="落点：apps/web/e2e/chief-thread-switcher-scroll.spec.ts 单处测量替换（width→offsetWidth）；稳定性 = 修复后 10 轮 30/30 绿；根因证据 = 逐帧探针（rect 248.9→262 收敛，offsetWidth 恒 262）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=2" vertex="1" parent="1">
