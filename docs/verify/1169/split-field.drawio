        <mxCell id="n2" value="skillsAllowlist: string[] | null（授权）&lt;br&gt;null = 不限制（全量可读，创建缺省）；&lt;br&gt;数组 = 白名单（名单外 Read 被 #917 硬挡）；&lt;br&gt;[] = 显式全拒（有意选择，不再是意外缺省）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
