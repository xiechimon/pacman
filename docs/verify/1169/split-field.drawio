        </mxCell>
        <mxCell id="m1" value="既有 [] 行 → null（解除出生即残废）&lt;br&gt;skills[0] 非空的行 → 该值进 defaultSkill&lt;br&gt;其余非空白名单原样进 skillsAllowlist" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
