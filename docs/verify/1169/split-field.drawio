        </mxCell>
        <mxCell id="o0" value="&lt;b&gt;旧：agent.skills: string[]（一列两义）&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="330" height="28" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="写入面只会产出 [] 或一元数组；&lt;br&gt;缺省 ?? [] ——新建 agent 出生即全拒（残废）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
