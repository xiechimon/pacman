<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- pacman executor daemon, user-domain launchd job (com.xiechimon.pacman-daemon.t142b).
     Rendered by install.sh (placeholders @..@ are baked to absolute paths;
     launchd does not expand ~, so nothing relative is used here).
     Semantics: KeepAlive restarts crashes/kills but NOT clean exits, so the
     run.sh singleton guard exiting 0 ("already running") stays quiet instead
     of spinning. ThrottleInterval caps any restart storm at one per 30s.
     Premise: the dev server on :8787 is NOT managed here — the daemon's
     claim loop backs off (cap 30s) and attaches once the server is up. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xiechimon.pacman-daemon.t142b</string>
  <key>ProgramArguments</key>
  <array>
    <string>/tmp/t142-home2/pacman-daemon-run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/tmp/t142-repo-scratch</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/xmon/.local/share/fnm/node-versions/v24.14.0/installation/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PACMAN_HOME</key>
    <string>/tmp/t142-home2</string>
    <key>PACMAN_SERVER</key>
    <string>http://127.0.0.1:9</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/tmp/t142-home2/launchd-daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/t142-home2/launchd-daemon.err.log</string>
</dict>
</plist>
