<mxfile host="app.diagrams.net">
  <diagram id="ci-grind-loop" name="ci-grind-loop">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="build step done with PR&#10;(prNumber backfilled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hold" value="completeStep: github project&#10;holds phase = building&#10;(grind in progress, no human gate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="poll" value="scheduler family loop&#10;60s cycle (own interval,&#10;not the sync tick)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="get" value="one conditional GET per PR&#10;commits/{conv-branch}/check-runs&#10;If-None-Match (304 reuses verdict)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="verdict" value="three-state verdict&#10;(reads current phase&#10;before every write)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="370" y="260" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="pending: check queued&#10;or in progress&#10;no action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="370" y="430" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fix" value="red: same build, append&#10;fix step (same conv, branch,&#10;PR updated in place)&#10;prompt = check names +&#10;output summaries + round" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="620" y="140" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fixinflight" value="fix step in flight blocks&#10;a second append&#10;(idempotent re-sweeps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="290" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="deadloop" value="3 consecutive fix rounds&#10;still red: dead-loop gate&#10;stop, build.errorMessage,&#10;todo -&gt; failed (human)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="910" y="140" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="review" value="green: setTodoPhase -&gt;&#10;review gate (human takes&#10;over; notify + chief wake)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="430" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scan" value="scan set = builds with prNumber&#10;AND todo phase = building&#10;(review/failed/closed/done stay out)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="entry" target="hold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="hold" target="poll">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="poll" target="get">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="verdict" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="get" target="verdict">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="pending" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="verdict" target="pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="red" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="verdict" target="fix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="round &lt; 3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="fix" target="fixinflight">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="round = 3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="fix" target="deadloop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="green" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="verdict" target="review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="next sweep" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="fixinflight" target="poll">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="batch scan" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="scan" target="poll">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>