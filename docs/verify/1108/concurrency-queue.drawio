<mxfile host="claude-agent" modified="2026-10-10T12:00:00.000Z" agent="drawio-skill" version="24.7.17" type="device">
  <diagram id="concurrency-queue-1108" name="machine concurrency cap and queue visibility">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="machine concurrency cap + queue visibility (#1108): a number on the machine, a gate on both sides, and a queue you can see" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bLabel" value="before (main, the 2026-10-10 incident)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1080" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="daemon loop is hard serial: claim → await runStep → claim — one machine runs exactly 1 step at a time" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="84" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="server has no gate (#503 removed the cap column); a busy machine = the second step waits as pending forever" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="84" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="UI: a pending turn renders 处理中... — a lie; the user sees a blocked card with zero hint (18 min silent wait)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="84" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fixLabel" value="#1108 — the number comes back (machine.maxConcurrent, default 3, PATCH 1..16), gated on both sides" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="186" width="1080" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="server gate (authoritative): tryClaim counts the machine's claimed steps; ≥ N → hands out nothing, the step stays pending — capacity queue is a legal state, never the failure funnel" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="212" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="daemon parallel loop: claim-and-launch, no await between steps; the in-flight set is capped by localCap read from GET /api/machine/me (field missing → 1 = serial, mixed-version safe); graceful stop waits for all in-flight steps" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="212" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="slot release wakes claims: finishStep fires a team wake at every terminal step — the queued head is claimed in seconds, not after the next ~75s long-poll hold" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="212" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fixArrow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b2" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="visLabel" value="queue visibility — the pending state tells the truth: position, who it waits for" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="334" width="1080" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="queue projection (step-queue.ts): every pending step derives position (createdAt FIFO; a pinned step counts only that machine's visible set) and waitingFor (pinned machine + running/capacity snapshot)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="chief drawer: the in-flight turn row switches to 排队中：等 {machine}（{running}/{cap} 在跑，前面 {ahead} 个） — position and machine are server-derived truth, not local guesswork" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="360" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="task detail: transcript streaming rows split pending vs claimed labels (排队中 vs 处理中); steps query rows carry queue; claimed → back to the existing labels, zero copy drift" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="360" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="machines page: 执行中 {n}/{cap} read annotation + the limit selector (second live control, PATCH single field); old-server shape (field absent) retires the whole group — fixture capture zero drift" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="710" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c2">
