        <mxCell id="title" value="#1148 daemon concurrency: chief exempt + port base + env fallback" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="16" width="900" height="26" as="geometry" />
        </mxCell>
        <mxCell id="srvT" value="Server claim gate (machines.ts tryClaim)" style="text;html=1;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="380" height="22" as="geometry" />
        </mxCell>
        <mxCell id="srvWorker" value="worker candidates gate: running &lt; min(machine.maxConcurrent, body.maxWorkers)&#10;running = non-chief claimed only (machineRunningCount excludes kind=chief)&#10;blocked workers stay pending (queue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=11;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="380" height="86" as="geometry" />
        </mxCell>
        <mxCell id="srvChief" value="chief candidates: exempt from both caps&#10;full workers do not starve chief (gate closed = earliestWorker = +inf, chief loop runs)&#10;chief never occupies a slot: me.runningSteps and waitingFor.running count workers only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="186" width="380" height="92" as="geometry" />
        </mxCell>
        <mxCell id="srvBody" value="claim body = {maxWorkers} (pure-addition, optional int &#8805; 1)&#10;absent (old daemon): gate = DB row only&#10;old server strips the key (zod) = current behavior, no version wall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="294" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dmnT" value="Daemon loop (machine-loop.ts)" style="text;html=1;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="60" width="390" height="22" as="geometry" />
        </mxCell>
        <mxCell id="dmnCap" value="localCap = env PACMAN_DAEMON_MAX_CONCURRENT &gt; me.maxConcurrent (DB) &gt; 1&#10;env &gt; DB is enforced end-to-end: every claim self-reports maxWorkers=localCap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;fontSize=11;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="86" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dmnPark" value="local park narrowed: only when server has no worker gate (me.maxConcurrent absent, pre-#1108) and workers &#8805; localCap&#10;otherwise the claim long-poll stays open — chief is claimable at any time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="170" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dmnSlot" value="worker slots: smallest free integer 1..N, released on step finish&#10;SessionOpts.env = {PACMAN_PORT_BASE: 20000 + (slot-1)x100}&#10;pi: bash tool override with spawnHook (env merged after PI_* vars)&#10;claude-code: SDK options.env = {...process.env, ...step env}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="254" width="390" height="104" as="geometry" />
        </mxCell>
        <mxCell id="dmnChief" value="chief step: no slot, no env (never occupies a slot, so no segment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;verticalAlign=top;spacing=6;" vertex="1" parent="1">
