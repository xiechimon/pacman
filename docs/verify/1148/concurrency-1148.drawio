        </mxCell>
        <mxCell id="acct" value="acceptance (integration/test/port-base-e2e.test.ts, real server + daemon + pi + stub LLM): cap 1 + one worker running = chief claimed immediately, second worker stays pending; two concurrent workers read distinct bases 20000 / 20100 out of the real bash env; DB 2 + env 1 = only one worker at a time (env &gt; DB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;verticalAlign=top;spacing=6;" vertex="1" parent="1">
