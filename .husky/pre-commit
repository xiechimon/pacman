#!/usr/bin/env sh
# Pacman pre-commit — single hook, runs the canonical check chain.
# Mirrors earendil-works/pi's pattern: lockfile guard + format+lint+typecheck + restage.
set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

# 1. Lockfile guard — confirm before letting pnpm-lock.yaml into the commit.
#    Escape hatch is an explicit env var, mirroring pi's PI_ALLOW_LOCKFILE_CHANGE
#    (pi: scripts/check-lockfile-commit.mjs). AGENTS.md bans `git commit --no-verify`,
#    so an authorized lockfile change needs a sanctioned exit through the hook itself.
if printf '%s\n' "$STAGED" | grep -qE '^pnpm-lock\.yaml$'; then
  ALLOW_LOCKFILE=${PACMAN_ALLOW_LOCKFILE_CHANGE:-}
  if [ "$ALLOW_LOCKFILE" = "1" ] || [ "$ALLOW_LOCKFILE" = "true" ] || [ "$ALLOW_LOCKFILE" = "yes" ]; then
    echo "pnpm-lock.yaml is staged; PACMAN_ALLOW_LOCKFILE_CHANGE is set, allowing commit." >&2
  else
    echo "⚠  pnpm-lock.yaml is staged." >&2
    echo "   This is allowed ONLY when the change is part of a deliberate dependency bump." >&2
    echo "   If this lockfile change is intentional, commit with:" >&2
    echo "     PACMAN_ALLOW_LOCKFILE_CHANGE=1 git commit ..." >&2
    echo "   To drop it, run \`git reset pnpm-lock.yaml\`." >&2
    exit 1
  fi
fi

# 1.5 黑名单注释（实现 ~/Code/AgentProjects/pacman/CLAUDE.md「注释纪律」）
# 黑名单外置到 .husky/banned.txt，本文件不含关键字词自身（避免自匹配）
# 同时排除 .husky/ 目录（工具脚本，加新词维护就改 banned.txt）
HUSKY_DIR="$(git rev-parse --show-toplevel)/.husky"
BANNED_FILE="$HUSKY_DIR/banned.txt"
[ -f "$BANNED_FILE" ] || { echo "missing banned-vocabulary file: $BANNED_FILE" >&2; exit 1; }
[ -r "$BANNED_FILE" ] || { echo "unreadable banned-vocabulary file (check permissions): $BANNED_FILE" >&2; exit 1; }
STAGED_FOR_GREP=$(printf '%s\n' "$STAGED" | grep -vE '^\.husky/' || true)
if [ -n "$STAGED_FOR_GREP" ]; then
  DIFF_OUT=$(git diff --cached -U0 -- $STAGED_FOR_GREP 2>/dev/null | grep -E '^\+' | grep -v '^+++' || true)
  # grep -f 失败默认吞掉会破坏 hook 立论（注释纪律）；按 rc 区分：1=无匹配正常；其他=I/O 故障 → exit 1
  BANNED_MATCH=$(printf '%s' "$DIFF_OUT" | grep -E -f "$BANNED_FILE") || {
    rc=$?
    if [ "$rc" -ne 1 ]; then
      echo "comment-discipline hook: grep -f $BANNED_FILE failed (rc=$rc); check permissions" >&2
      exit 1
    fi
  }
  if [ -n "$BANNED_MATCH" ]; then
    echo "Blocked (comment discipline): banned vocabulary in staged additions." >&2
    echo "  (per pacman CLAUDE.md; fix comments, or git commit --no-verify with explicit justification)" >&2
    echo "$BANNED_MATCH" | sed 's/^/  /' >&2
    exit 1
  fi
fi

# 2. biome format (writes) + biome ci (read-only check)
pnpm exec biome format --write . >/dev/null 2>&1 || true
pnpm exec biome ci .

# 3. typecheck — only when TS source in apps/*/src, packages/*/src, or integration actually changed
HAS_DEEP_TS=$(printf '%s\n' "$STAGED" | grep -E '^(apps|packages|integration)/.*\.(ts|tsx|js|mjs|cjs)$' || true)
if [ -n "$HAS_DEEP_TS" ]; then
  pnpm -r typecheck
fi

# 4. Restage anything biome format --write modified
for f in $STAGED; do
  [ -f "$f" ] && git add "$f"
done

echo "✅ pre-commit checks passed"
